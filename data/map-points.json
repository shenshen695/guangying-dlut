  {"id":"flower-wall","x":44,"y":45.5,"name":"花墙","imageSrc":"","description":"花墙适合作为路线收尾，用一组颜色明亮、情绪轻快的照片，为毕业影像留下最后一帧。","bestTime":"17:00–18:30","seasonNote":""},
